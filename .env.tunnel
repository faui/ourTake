# Worker profile for running behind a Cloudflare named tunnel (trainer trials).
# TLS terminates at Cloudflare's edge; cloudflared connects to this worker over
# loopback, so the worker binds 127.0.0.1 with no local TLS. No secrets here.
PORT=4100
HOST=127.0.0.1
MAX_UPLOAD_BYTES=2147483648
MAX_STORAGE_BYTES=53687091200

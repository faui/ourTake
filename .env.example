# Local capture API and FFmpeg worker. Node 24+ recommended.
PORT=4100
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4100
# Optional for trusted HTTPS. Add its exact origin above.
# TLS_CERT=C:/path/to/trusted-cert.pem
# TLS_KEY=C:/path/to/trusted-key.pem
# FFMPEG_PATH=C:/Program Files/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/Program Files/ffmpeg/bin/ffprobe.exe
MAX_UPLOAD_BYTES=2147483648
MAX_STORAGE_BYTES=53687091200
# Optional hosted frontend -> HTTPS worker. Public URL ONLY, never a secret.
# VITE_OURFRAME_API_URL=https://your-worker.example.com
